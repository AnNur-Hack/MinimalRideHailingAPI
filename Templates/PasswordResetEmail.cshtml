@model MinimalRideHailingAPI.Templates.PasswordResetEmailModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Password Reset</title>
</head>

<body>
<h2>Password Reset Request</h2>

<p>Hello @Model.FullName,</p>

<p>
    We received a request to reset your RideHailingAPI password.
</p>

<p>
    Your password reset OTP is:
</p>

<h1>@Model.OtpCode</h1>

<p>
    This OTP will expire in 5 minutes.
</p>

<p>
    If you did not request a password reset, you can safely ignore this email.
</p>

<p>
    Regards,<br />
    RideHailingAPI Team
</p>
</body>
</html>